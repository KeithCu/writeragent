---
options:
  max_actions: 4
  max_concurrent_actions: 1
  crash_on_yield: false
deadlock_detection: false
---
# Nested-text mapping: one XText per container.

action Init:
    body_text = ""
    bookmarks = {}
    footnotes = {}
    frames = {}
    tables = {}
    track_changes_enabled = False
    pending_count = 0
    last_status = "OK"
    cursor_kind = "body"
    cursor_id = ""
    cursor_start = 0
    cursor_end = 0
    last_apply_kind = "body"

atomic action ApplyContent:
    require len(body_text) < 10
    text = oneof ["Hello", "Intro"]
    target = oneof ["end", "start", "replace_all"]
    if target == "replace_all":
        body_text = text
    elif target == "start":
        body_text = text + body_text
    else:
        body_text = body_text + text
    last_status = "OK"
    last_apply_kind = "body"
    cursor_kind = "body"
    cursor_id = ""
    cursor_start = 0
    cursor_end = 0
    bookmarks = {}

atomic action ApplySelection:
    text = oneof ["Z", "EDIT"]
    # Correct mapping: write the cursor container, never the body while nested.
    if cursor_kind == "cell":
        tname = cursor_id
        if tname in tables:
            t = tables[tname]
            tables[tname] = {"rows": t["rows"], "cols": t["cols"], "cell": text}
            last_apply_kind = "cell"
            last_status = "OK"
            cursor_start = 0
            cursor_end = len(text)
        else:
            last_status = "NOT_FOUND"
    elif cursor_kind == "footnote":
        if cursor_id in footnotes:
            footnotes[cursor_id] = text
            last_apply_kind = "footnote"
            last_status = "OK"
            cursor_start = 0
            cursor_end = len(text)
        else:
            last_status = "NOT_FOUND"
    elif cursor_kind == "frame":
        if cursor_id in frames:
            frames[cursor_id] = text
            last_apply_kind = "frame"
            last_status = "OK"
            cursor_start = 0
            cursor_end = len(text)
        else:
            last_status = "NOT_FOUND"
    else:
        body_text = text
        last_apply_kind = "body"
        last_status = "OK"
        cursor_start = 0
        cursor_end = len(text)
        bookmarks = {}

atomic action InsertBookmark:
    name = oneof ["bm_intro", "bm_chapter1"]
    bookmarks[name] = len(body_text)
    last_status = "OK"

atomic action DeleteBookmark:
    name = oneof ["bm_intro", "bm_chapter1", "non_existent"]
    if name in bookmarks:
        bookmarks.pop(name)
        last_status = "OK"
    else:
        last_status = "NOT_FOUND"

atomic action InsertFootnote:
    require len(footnotes) < 2
    text = oneof ["Citation 1", "See note"]
    fn_id = "fn_" + str(len(footnotes) + 1)
    footnotes[fn_id] = text
    last_status = "OK"

atomic action DeleteFootnote:
    fn_id = oneof ["fn_1", "fn_2", "fn_invalid"]
    if fn_id in footnotes:
        footnotes.pop(fn_id)
        if cursor_kind == "footnote" and cursor_id == fn_id:
            cursor_kind = "body"
            cursor_id = ""
            cursor_start = 0
            cursor_end = 0
        last_status = "OK"
    else:
        last_status = "NOT_FOUND"

atomic action InsertFrame:
    require len(frames) < 2
    fr_id = "fr_" + str(len(frames) + 1)
    frames[fr_id] = "frame text"
    last_status = "OK"

atomic action CreateTable:
    table_name = oneof ["Table1", "Table2"]
    rows = 2
    cols = 2
    tables[table_name] = {"rows": rows, "cols": cols, "cell": ""}
    last_status = "OK"

atomic action SetCell:
    table_name = oneof ["Table1", "Table2"]
    text = oneof ["MinerU", "ab"]
    if table_name in tables:
        t = tables[table_name]
        tables[table_name] = {"rows": t["rows"], "cols": t["cols"], "cell": text}
        last_status = "OK"
    else:
        last_status = "NOT_FOUND"

atomic action MoveCursorToCell:
    table_name = oneof ["Table1", "Table2"]
    if table_name in tables:
        cursor_kind = "cell"
        cursor_id = table_name
        cursor_start = 0
        cursor_end = len(tables[table_name]["cell"])
        last_status = "OK"
    else:
        last_status = "NOT_FOUND"

atomic action MoveCursorToFootnote:
    fn_id = oneof ["fn_1", "fn_2"]
    if fn_id in footnotes:
        cursor_kind = "footnote"
        cursor_id = fn_id
        cursor_start = 0
        cursor_end = len(footnotes[fn_id])
        last_status = "OK"
    else:
        last_status = "NOT_FOUND"

atomic action DeleteCharsInCursor:
    if cursor_kind == "cell" and cursor_id in tables:
        t = tables[cursor_id]
        tables[cursor_id] = {"rows": t["rows"], "cols": t["cols"], "cell": ""}
        cursor_end = 0
        last_status = "OK"
    elif cursor_kind == "footnote" and cursor_id in footnotes:
        footnotes[cursor_id] = ""
        cursor_end = 0
        last_status = "OK"
    elif cursor_kind == "frame" and cursor_id in frames:
        frames[cursor_id] = ""
        cursor_end = 0
        last_status = "OK"
    else:
        body_text = ""
        cursor_end = 0
        bookmarks = {}
        last_status = "OK"

atomic action GetSelection:
    last_status = "OK"

atomic action ToggleTrackChanges:
    enable = oneof [True, False]
    track_changes_enabled = enable
    last_status = "OK"

atomic action RecordChange:
    require track_changes_enabled
    require pending_count < 2
    pending_count = pending_count + 1
    last_status = "OK"

atomic action ResolveChange:
    require pending_count > 0
    pending_count = pending_count - 1
    last_status = "OK"

always assertion Inv_BookmarksBounded:
    for pos in bookmarks.values():
        if pos > len(body_text):
            return False
    return True

always assertion Inv_TablesValidDimensions:
    for t in tables.values():
        if t["rows"] <= 0 or t["cols"] <= 0:
            return False
    return True

always assertion Inv_PendingChangesOnlyWhenRecorded:
    return pending_count >= 0

always assertion Inv_CursorSameContainer:
    return cursor_start >= 0 and cursor_end >= cursor_start

always assertion Inv_ApplyWroteCursorKind:
    # ApplySelection records last_apply_kind from the cursor at apply time.
    return last_apply_kind == "body" or last_apply_kind == "cell" or last_apply_kind == "footnote" or last_apply_kind == "frame"
