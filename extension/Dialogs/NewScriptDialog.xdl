<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script"
  dlg:id="NewScriptDialog" dlg:left="100" dlg:top="50" dlg:width="280" dlg:height="105"
  dlg:closeable="true" dlg:moveable="true" dlg:title="New Python Script">
 <!-- =========================================================================================
      WARNING: PARITY INVARIANT WITH MONACO HTML / JS FRONTEND
      If you modify controls, IDs, or layout in this dialog, you MUST update:
        - Monaco New Script Modal:  plugin/contrib/scripting/assets/editor/index.html (#new-script-modal)
        - JS Modal Handler:         plugin/contrib/scripting/assets/editor/scripts_manager.js (onCreateNewScript)
        - Python Dialog Helper:     plugin/scripting/script_dialogs.py (show_new_script_dialog)
        - Python Dialog Listener:   plugin/scripting/python_runner_ui.py (_on_new)
      ========================================================================================= -->
 <dlg:bulletinboard>
  <dlg:text dlg:id="PromptLbl" dlg:left="8" dlg:top="8" dlg:width="264" dlg:height="10" dlg:value="Script name:" dlg:align="left" dlg:multiline="false"/>
  <dlg:textfield dlg:id="NameEdit" dlg:left="8" dlg:top="22" dlg:width="264" dlg:height="14" dlg:tabstop="true"/>
  <dlg:checkbox dlg:id="ChkAttach" dlg:left="8" dlg:top="44" dlg:width="264" dlg:height="14" dlg:value="Attach to this document" dlg:tabstop="true"/>
  <dlg:button dlg:id="BtnOK" dlg:left="150" dlg:top="74" dlg:width="60" dlg:height="14" dlg:value="OK" dlg:tabstop="true"/>
  <dlg:button dlg:id="BtnCancel" dlg:left="216" dlg:top="74" dlg:width="56" dlg:height="14" dlg:value="Cancel" dlg:tabstop="true"/>
 </dlg:bulletinboard>
</dlg:window>
