msgstr "Kokoro (本地神经网络, ONNX CPU)"

msgid "Piper (Local Fast Neural, CPU)"
msgstr "Piper (本地快速神经网络, CPU)"

msgid "LLM Endpoint"
msgstr "LLM 端点"

msgid "TTS Model"
msgstr "TTS 模型"

msgid "Model for speech synthesis (used when TTS Provider is LLM Endpoint)."
msgstr "用于语音合成的模型（当 TTS 提供程序为 LLM 端点时使用）。"

msgid "Voice"
msgstr "语音"

msgid ""
"Voice for the selected provider. The list matches the Piper or Kokoro "
"catalog for your locale."
msgstr "所选提供程序的语音。该列表与您所在区域设置的 Piper 或 Kokoro 目录相匹配。"

