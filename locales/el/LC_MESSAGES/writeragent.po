#: plugin/framework/errors.py
#, python-brace-format
msgid "TLS/SSL Error: {0}"
msgstr "Σφάλμα TLS/SSL: {0}"

#: plugin/framework/errors.py
msgid "Invalid API Key. Please check your settings."
msgstr "Μη έγκυρο κλειδί API. Παρακαλούμε ελέγξτε τις ρυθμίσεις σας."

#: plugin/framework/errors.py
msgid "API access Forbidden. Your key may lack permissions for this model."
msgstr ""
"Απαγορευμένη πρόσβαση API. Το κλειδί σας ενδέχεται να μην έχει δικαιώματα "
"για αυτό το μοντέλο."

#: plugin/framework/errors.py
msgid "Endpoint not found (404). Check your URL and Model name."
msgstr ""
"Το τελικό σημείο (endpoint) δεν βρέθηκε (404). Ελέγξτε το URL και το όνομα "
"του μοντέλου σας."

#: plugin/framework/errors.py plugin/framework/client/errors.py
msgid "Rate limited (429). Wait a moment and try again."
msgstr "Υπέρβαση ορίου ρυθμού (429). Περιμένετε λίγο και προσπαθήστε ξανά."

#: plugin/framework/errors.py
#, python-brace-format
msgid "Server error ({0}). The AI provider is having issues."
msgstr "Σφάλμα διακομιστή ({0}). Ο πάροχος AI αντιμετωπίζει προβλήματα."

#: plugin/framework/errors.py
#, python-brace-format
msgid "HTTP Error {0}: {1}"
msgstr "Σφάλμα HTTP {0}: {1}"

#: plugin/framework/errors.py
#, python-brace-format
msgid "No API key configured for {0}. Open Settings and add a key."
msgstr ""
"Δεν έχει ρυθμιστεί κλειδί API για το {0}. Ανοίξτε τις Ρυθμίσεις και "
"προσθέστε ένα κλειδί."

#: plugin/framework/errors.py
msgid "No API key configured. Open Settings and add a key."
msgstr ""
"Δεν έχει ρυθμιστεί κλειδί API. Ανοίξτε τις Ρυθμίσεις και προσθέστε ένα "
"κλειδί."

#: plugin/framework/errors.py
msgid ""
"Python venv not found. Open Settings → Python, set the venv path, then Test."
msgstr ""
"Το Python venv δεν βρέθηκε. Ανοίξτε τις Ρυθμίσεις → Python, ορίστε τη "
"διαδρομή venv και μετά κάντε Δοκιμή."

#: plugin/framework/errors.py
msgid ""
"Python execution timed out. Open Settings → Python to raise the timeout."
msgstr ""
"Η εκτέλεση της Python έληξε χρονικά. Ανοίξτε τις Ρυθμίσεις → Python για να "
"αυξήσετε το χρονικό όριο."

#: plugin/framework/errors.py
msgid "Formula spill collision: destination range contains non-empty cells."
msgstr ""
"Σύγκρουση υπερχείλισης τύπου: η περιοχή προορισμού περιέχει μη κενά κελιά."

#: plugin/framework/errors.py
#, python-brace-format
msgid "Script execution blocked by sandbox policy: {0}"
msgstr "Η εκτέλεση δέσμης ενεργειών αποκλείστηκε από την πολιτική sandbox: {0}"

#: plugin/framework/errors.py
msgid "Request Timed Out. Try increasing 'Request Timeout' in Settings."
msgstr ""
"Το αίτημα έληξε. Δοκιμάστε να αυξήσετε το «Χρονικό όριο αιτήματος» στις "
"Ρυθμίσεις."

#: plugin/framework/errors.py
msgid "Connection Refused. Is your local AI server (Ollama/LM Studio) running?"
msgstr ""
"Η σύνδεση απορρίφθηκε. Είναι ενεργός ο τοπικός διακομιστής AI (Ollama/LM "
"Studio);"

#: plugin/framework/errors.py
msgid "DNS Error. Could not resolve the endpoint URL."
msgstr ""
"Σφάλμα DNS. Δεν ήταν δυνατή η ανάλυση της διεύθυνσης URL του τελικού σημείου."

#: plugin/framework/errors.py
#, python-brace-format
msgid "Connection Error: {0}"
msgstr "Σφάλμα σύνδεσης: {0}"

#: plugin/framework/errors.py
msgid "The AI provider reported an error. Try again."
msgstr "Ο πάροχος AI ανέφερε ένα σφάλμα. Προσπαθήστε ξανά."

#: plugin/framework/errors.py
#, python-brace-format
msgid "{resource_type} not found: {identifier}"
msgstr "Το {resource_type} δεν βρέθηκε: {identifier}"

#: plugin/framework/config_schema.py
msgid "Chat max tokens must be >= 0"
msgstr "Τα μέγιστα tokens συνομιλίας πρέπει να είναι >= 0"

#: plugin/framework/config_schema.py
msgid "Request timeout must be > 0"
msgstr "Το χρονικό όριο αιτήματος πρέπει να είναι > 0"

#: plugin/framework/config_schema.py
msgid "Temperature must be <= 1.0"
msgstr "Η θερμοκρασία πρέπει να είναι <= 1.0"

#: plugin/framework/thread_guard.py
msgid "UNO Thread Violation"
msgstr "Παραβίαση νήματος UNO"

#: plugin/framework/client/errors.py
#, python-brace-format
msgid ""
"The local Ollama/llama.cpp process crashed because the prompt overflowed a "
"{0} context window."
msgstr ""
"Η τοπική διεργασία Ollama/llama.cpp κατέρρευσε επειδή το prompt ξεπέρασε το "
"παράθυρο πλαισίου {0}."

#: plugin/framework/client/errors.py
msgid ""
"The local Ollama/llama.cpp process crashed because the prompt overflowed a "
"too-small context window."
msgstr ""
"Η τοπική διεργασία Ollama/llama.cpp κατέρρευσε επειδή το prompt ξεπέρασε ένα "
"πολύ μικρό παράθυρο πλαισίου."

#: plugin/framework/client/errors.py
#, python-brace-format
msgid "HTTP Error {0} from AI Provider: {1}"
msgstr "Σφάλμα HTTP {0} από τον πάροχο AI: {1}"

#: plugin/framework/client/errors.py
#, python-brace-format
msgid ""
" If your API key is from a GLM Coding Plan subscription, set endpoint to {0} "
"(not the general /api/paas URL)."
msgstr ""
" Εάν το κλειδί API προέρχεται από συνδρομή GLM Coding Plan, ορίστε το τελικό "
"σημείο (endpoint) στο {0} (όχι στο γενικό URL /api/paas)."

#: plugin/framework/client/errors.py
#, python-brace-format
msgid " Request model was: {0}."
msgstr " Το μοντέλο αιτήματος ήταν: {0}."

#: plugin/framework/client/errors.py plugin/calc/python/function.py
