#: plugin/calc/python/editor.py
msgid ""
"Could not preserve this cell's PY formula arguments (e.g. data ranges). Edit "
"the formula in Calc, or use a quoted code string like =PY(\"code\"; A1:B10)."
msgstr ""
"Δεν ήταν δυνατή η διατήρηση των ορισμάτων τύπου PY αυτού του κελιού (π.χ. "
"περιοχές δεδομένων). Επεξεργαστείτε τον τύπο στο Calc ή χρησιμοποιήστε μια "
"συμβολοσειρά κώδικα σε εισαγωγικά, όπως =PY(\"code\"; A1:B10)."

#: plugin/calc/python/editor.py
msgid "this cell"
msgstr "αυτό το κελί"

#: plugin/calc/python/editor.py
#, python-brace-format
