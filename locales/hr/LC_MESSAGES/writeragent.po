msgstr "Piper (lokalna brza neuronska, CPU)"

msgid "LLM Endpoint"
msgstr "LLM krajnja točka"

msgid "TTS Model"
msgstr "TTS model"

msgid "Model for speech synthesis (used when TTS Provider is LLM Endpoint)."
msgstr ""
"Model za sintezu govora (koristi se kada je TTS pružatelj LLM krajnja "
"točka)."

msgid "Voice"
msgstr "Glas"

msgid ""
"Voice for the selected provider. The list matches the Piper or Kokoro "
"catalog for your locale."
msgstr ""
"Glas za odabranog pružatelja. Popis odgovara Piper ili Kokoro katalogu za "
"vaš lokalitet."

