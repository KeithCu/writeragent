msgstr "Poravnaj otkrivene ćelije tablice sa sadržajem (extract_structure)."

msgid "Keep orphan text clusters"
msgstr "Zadrži siročad tekstualnih klastera"

msgid "Group unassigned text into clusters for messy layouts."
msgstr "Grupiraj nedodijeljeni tekst u klastere za neuredne rasporede."

msgid "Document insert mode"
msgstr "Način umetanja dokumenta"

msgid ""
"html = Docling HTML import (default). structured = bbox column layout in "
"Writer; native Calc cells for extract_structure tables."
msgstr ""
"html = Docling HTML uvoz (zadano). structured = bbox raspored stupaca u "
"Writeru; izvorne Calc ćelije za tablice extract_structure."

msgid "Standard HTML"
msgstr "Standardni HTML"

msgid "Structured (layout / cell grid)"
msgstr "Strukturirano (raspored / mreža ćelija)"

msgid "Layout model"
msgstr "Model rasporeda"

msgid "Heron (default)"
msgstr "Heron (zadano)"

msgid "Egret large (slower"
msgstr "Egret large (sporije"

msgid "Extract formulas (LaTeX)"
msgstr "Izvuci formule (LaTeX)"

msgid "Opt-in. Downloads extra VLM models on first use; slower."
msgstr "Uključivanje. Preuzima dodatne VLM modele pri prvoj uporabi; sporije."

msgid "Code block enrichment"
msgstr "Obogaćivanje bloka koda"

msgid "Specialized OCR for code/terminal screenshots."
msgstr "Specijalizirani OCR za snimke zaslona koda/terminala."

msgid "Docling document timeout (s)"
msgstr "Vremensko ograničenje Docling dokumenta (s)"

msgid "Per-conversion timeout inside Docling. 0 = no limit."
msgstr ""
"Vremensko ograničenje po pretvorbi unutar Doclinga. 0 = bez ograničenja."
