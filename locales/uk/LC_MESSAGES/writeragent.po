msgstr "Помилка сервера ({0}). Постачальник ШІ має проблеми."

#: plugin/framework/errors.py
#, python-brace-format
msgid "HTTP Error {0}: {1}"
msgstr "Помилка HTTP {0}: {1}"

#: plugin/framework/errors.py
#, python-brace-format
msgid "No API key configured for {0}. Open Settings and add a key."
msgstr ""
"Для {0} не налаштовано ключ API. Відкрийте «Налаштування» та додайте ключ."

#: plugin/framework/errors.py
msgid "No API key configured. Open Settings and add a key."
msgstr "Ключ API не налаштовано. Відкрийте «Налаштування» та додайте ключ."

