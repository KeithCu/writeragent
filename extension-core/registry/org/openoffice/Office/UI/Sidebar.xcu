<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data
    oor:name="Sidebar"
    oor:package="org.openoffice.Office.UI"
    xmlns:oor="http://openoffice.org/2001/registry"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:install="http://openoffice.org/2004/installation">
    <node oor:name="Content">
        <node oor:name="DeckList">
            <node oor:name="LibrePyDeck" oor:op="replace">
                <prop oor:name="Title" oor:type="xs:string">
                    <value xml:lang="en-US">Python</value>
                </prop>
                <prop oor:name="Id" oor:type="xs:string">
                    <value>LibrePyDeck</value>
                </prop>
                <!-- Deck icons ship as 24 px PNGs, the macOS size (24-point slot). On other systems the slot grows with the DPI bucket, so plugin/framework/menu_icon_dpi.py apply_deck_icons stores a 24, 32 or 48 px IconURL picked from the DPI bucket in the user configuration when a panel is built. Not SVG: LibreOffice rasterizes an extension SVG IconURL once at screen DPI (vectorgraphicdata.cxx convertPrimitive2DSequenceToBitmap), so on macOS it becomes about 27-33 px, and it gets no HiDPI redraw (ImplImage::getBitmapForHiDPI covers only stock and metafile images); assets/python_logo.svg is the source for python_24.png, python_32.png and python_48.png. -->
                <prop oor:name="IconURL" oor:type="xs:string">
                    <value>vnd.sun.star.extension://org.extension.librepy/assets/python_24.png</value>
                </prop>
                <prop oor:name="ContextList">
                    <value oor:separator=";">com.sun.star.sheet.SpreadsheetDocument, any, visible; com.sun.star.text.TextDocument, any, visible; com.sun.star.text.WebDocument, any, visible; com.sun.star.text.GlobalDocument, any, visible;</value>
                </prop>
            </node>
        </node>
        <node oor:name="PanelList">
            <node oor:name="PythonPanel" oor:op="replace">
                <prop oor:name="Title" oor:type="xs:string">
                    <value xml:lang="en-US">Python</value>
                </prop>
                <prop oor:name="Id" oor:type="xs:string">
                    <value>PythonPanel</value>
                </prop>
                <prop oor:name="DeckId" oor:type="xs:string">
                    <value>LibrePyDeck</value>
                </prop>
                <prop oor:name="ContextList">
                    <value oor:separator=";">com.sun.star.sheet.SpreadsheetDocument, any, visible; com.sun.star.text.TextDocument, any, visible; com.sun.star.text.WebDocument, any, visible; com.sun.star.text.GlobalDocument, any, visible;</value>
                </prop>
                <prop oor:name="ImplementationURL" oor:type="xs:string">
                    <value>private:resource/toolpanel/PythonPanelFactory/PythonPanel</value>
                </prop>
                <prop oor:name="OrderIndex" oor:type="xs:int">
                    <value>100</value>
                </prop>
                <prop oor:name="WantsCanvas" oor:type="xs:boolean">
                    <value>false</value>
                </prop>
                <prop oor:name="WantsAWT" oor:type="xs:boolean">
                    <value>true</value>
                </prop>
                <prop oor:name="DefaultMenuCommand">
                    <value></value>
                </prop>
            </node>
        </node>
    </node>
</oor:component-data>
