{
  "typeCheckingMode": "all",
  "pythonVersion": "3.11",
  "venvPath": ".",
  "venv": ".venv",
  "include": ["plugin", "compute_service"],
  "exclude": [
    "plugin/contrib",
    "plugin/lib",
    "plugin/tests",
    "tests",
    "plugin/scripting/venv/text_analytics.py",
    "plugin/scripting/venv/quant.py"
  ],
  "useLibraryCodeForTypes": true,
  "reportMissingModuleSource": false,
  "reportMissingImports": "none",
  "reportAny": false,
  "reportExplicitAny": false,
  "reportUnknownMemberType": false,
  "reportUnknownVariableType": false,
  "reportUnknownParameterType": false,
  "reportMissingParameterType": true,
  "reportUnknownArgumentType": false,
  "reportConstantRedefinition": false,
  "reportImplicitAbstractClass": false,
  "reportPrivateLocalImportUsage": false,
  "reportUnnecessaryIsInstance": false,
  "reportUnnecessaryCast": false,
  "reportUnnecessaryComparison": false,
  "reportUnreachable": false,
  "reportMissingTypeStubs": false,
  "reportCallInDefaultInitializer": false,
  "reportUnsafeMultipleInheritance": false,
  "reportMissingSuperCall": false,
  "reportUnannotatedClassAttribute": true,
  "reportUnknownLambdaType": false,
  "reportPrivateUsage": false,
  "reportUnusedParameter": false,
  "reportDeprecated": false,
  "reportImplicitOverride": false,
  "reportUnusedCallResult": false,
  "reportImportCycles": false,
  "reportImplicitStringConcatenation": false,
  "reportUnnecessaryTypeIgnoreComment": false,
  "reportMissingTypeArgument": true
}
